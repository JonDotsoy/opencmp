---
import {
  CookieDialogSettings,
  CookiesManager,
} from "@/components/ui/cookies-manager";
import "../../styles/global.css";
import { SamplesCodeTabs, SettingsCodeTabs } from "@/components/CodeTabs";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { IconBrandNpm, IconBrandPnpm, IconCoffee } from "@tabler/icons-react";
import { InstallationTabs } from "@/components/InstallationTabs";
import opencmpLogo from "@/assets/opencmp-logo.svg";
import { getImage } from "astro:assets";

const logo = await getImage({
  src: opencmpLogo,
  width: 32,
  height: 32,
  format: "svg",
});

const baseUrl = import.meta.env.BASE_URL;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>
      OpenCMP Cookies Manager - Gestión de Consentimiento GDPR y CCPA
    </title>
    <meta
      name="description"
      content="Solución moderna y completa para la gestión de consentimiento de cookies con integración directa a Google Tag Manager. Compatible con GDPR y CCPA."
    />
    <meta
      name="keywords"
      content="cookies manager, GDPR, CCPA, consentimiento, privacy, Google Tag Manager, React, Tailwind CSS, shadcn/ui"
    />
    <meta name="author" content="OpenCMP" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="OpenCMP Cookies Manager - Gestión de Consentimiento GDPR y CCPA"
    />
    <meta
      property="og:description"
      content="Solución moderna y completa para la gestión de consentimiento de cookies con integración directa a Google Tag Manager. Compatible con GDPR y CCPA."
    />
    <meta property="og:image" content="/image.png" />
    <meta property="og:url" content="https://jondotsoy.github.io/opencmp/" />
    <meta property="og:site_name" content="OpenCMP Cookies Manager" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="OpenCMP Cookies Manager - Gestión de Consentimiento GDPR y CCPA"
    />
    <meta
      name="twitter:description"
      content="Solución moderna y completa para la gestión de consentimiento de cookies con integración directa a Google Tag Manager."
    />
    <meta name="twitter:image" content="/image.png" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://jondotsoy.github.io/opencmp/" />

    <!-- Additional SEO -->
    <meta name="theme-color" content="#2563eb" />
    <meta name="application-name" content="OpenCMP Cookies Manager" />
    <meta name="msapplication-TileColor" content="#2563eb" />

    <!-- Animated Background Styles -->
    <style>
      :root {
        /* Animation Durations */
        --gradient-duration: 15s;
        --float-1-duration: 8s;
        --float-2-duration: 6s;
        --float-3-duration: 10s;
        --particle-duration: 12s;

        /* Animation Easing Functions */
        --gradient-easing: ease;
        --float-easing: ease-in-out;
        --particle-easing: ease-in-out;

        /* Float Movement Distances */
        --float-1-y-small: -20px;
        --float-1-y-medium: 10px;
        --float-2-y: -30px;
        --float-3-y-small: -15px;
        --float-3-y-large: -25px;
        --float-3-y-medium: -10px;

        /* Particle Movement */
        --particle-move-y: -100px;
        --particle-move-x: 50px;
        --particle-opacity-min: 0.3;
        --particle-opacity-max: 0.8;

        /* Gradient Background Colors */
        --gradient-color-1: #dbeafe;
        --gradient-color-2: #e0e7ff;
        --gradient-color-3: #f3e8ff;
        --gradient-color-4: #ecfdf5;

        /* Particle Colors */
        --particle-color-1: #3b82f6;
        --particle-color-2: #8b5cf6;

        /* Background Size Values */
        --gradient-size-large: 400% 400%;
        --gradient-size-medium: 200% 200%;

        /* Animation Delays */
        --delay-0: 0s;
        --delay-2: -2s;
        --delay-3: -3s;
        --delay-4: -4s;
        --delay-6: -6s;
        --delay-7: -7s;
        --delay-8: -8s;
        --delay-10: -10s;

        /* Particle Sizes */
        --particle-size-xs: 4px;
        --particle-size-sm: 5px;
        --particle-size-md: 6px;
        --particle-size-lg: 7px;
        --particle-size-xl: 8px;
        --particle-size-2xl: 9px;
        --particle-size-3xl: 10px;
        --particle-size-4xl: 12px;

        /* SVG Animation Properties */
        --svg-float-duration: 20s;
        --svg-rotate-duration: 30s;
        --svg-scale-duration: 15s;
        --svg-opacity-min: 0.1;
        --svg-opacity-max: 0.3;
        --svg-size-small: 60px;
        --svg-size-medium: 80px;
        --svg-size-large: 100px;

        /* SVG Scale Animation Steps */
        --svg-scale-start: 1;
        --svg-scale-step1: 0.8;
        --svg-scale-step2: 0.6;
        --svg-scale-step3: 0.4;
        --svg-scale-end: 0.2;

        /* SVG Colors */
        --svg-color-primary: #3b82f6;
        --svg-color-secondary: #8b5cf6;
        --svg-color-accent: #06b6d4;
      }

      @keyframes gradient-xy {
        0%,
        100% {
          background-size: var(--gradient-size-large);
          background-position: 0% 50%;
        }
        50% {
          background-size: var(--gradient-size-medium);
          background-position: 100% 50%;
        }
      }

      @keyframes float-1 {
        0%,
        100% {
          transform: translateY(0px) rotate(0deg);
        }
        33% {
          transform: translateY(var(--float-1-y-small)) rotate(120deg);
        }
        66% {
          transform: translateY(var(--float-1-y-medium)) rotate(240deg);
        }
      }

      @keyframes float-2 {
        0%,
        100% {
          transform: translateY(0px) rotate(0deg);
        }
        50% {
          transform: translateY(var(--float-2-y)) rotate(180deg);
        }
      }

      @keyframes float-3 {
        0%,
        100% {
          transform: translateY(0px) rotate(0deg);
        }
        25% {
          transform: translateY(var(--float-3-y-small)) rotate(90deg);
        }
        50% {
          transform: translateY(var(--float-3-y-large)) rotate(180deg);
        }
        75% {
          transform: translateY(var(--float-3-y-medium)) rotate(270deg);
        }
      }

      @keyframes particle-float {
        0%,
        100% {
          transform: translateY(0px) translateX(0px);
          opacity: var(--particle-opacity-min);
        }
        50% {
          transform: translateY(var(--particle-move-y))
            translateX(var(--particle-move-x));
          opacity: var(--particle-opacity-max);
        }
      }

      @keyframes svg-float {
        0% {
          transform: translateY(0px) translateX(0px) rotate(0deg)
            scale(var(--svg-scale-start));
          opacity: var(--svg-opacity-min);
        }
        25% {
          transform: translateY(-30px) translateX(20px) rotate(90deg)
            scale(var(--svg-scale-step1));
          opacity: var(--svg-opacity-max);
        }
        50% {
          transform: translateY(-60px) translateX(-10px) rotate(180deg)
            scale(var(--svg-scale-step2));
          opacity: var(--svg-opacity-min);
        }
        75% {
          transform: translateY(-20px) translateX(-30px) rotate(270deg)
            scale(var(--svg-scale-step3));
          opacity: var(--svg-opacity-max);
        }
        100% {
          transform: translateY(0px) translateX(0px) rotate(360deg)
            scale(var(--svg-scale-end));
          opacity: var(--svg-opacity-min);
        }
      }

      @keyframes svg-pulse {
        0% {
          transform: scale(var(--svg-scale-start)) rotate(0deg);
          opacity: var(--svg-opacity-min);
        }
        25% {
          transform: scale(var(--svg-scale-step1)) rotate(45deg);
          opacity: var(--svg-opacity-max);
        }
        50% {
          transform: scale(var(--svg-scale-step2)) rotate(180deg);
          opacity: var(--svg-opacity-max);
        }
        75% {
          transform: scale(var(--svg-scale-step3)) rotate(270deg);
          opacity: var(--svg-opacity-min);
        }
        100% {
          transform: scale(var(--svg-scale-end)) rotate(360deg);
          opacity: var(--svg-opacity-min);
        }
      }

      .animate-gradient-xy {
        animation: gradient-xy var(--gradient-duration) var(--gradient-easing)
          infinite;
        background: linear-gradient(
          -45deg,
          var(--gradient-color-1),
          var(--gradient-color-2),
          var(--gradient-color-3),
          var(--gradient-color-4)
        );
      }

      .animate-float-1 {
        animation: float-1 var(--float-1-duration) var(--float-easing) infinite;
      }

      .animate-float-2 {
        animation: float-2 var(--float-2-duration) var(--float-easing) infinite;
      }

      .animate-float-3 {
        animation: float-3 var(--float-3-duration) var(--float-easing) infinite;
      }

      .particle {
        position: absolute;
        background: linear-gradient(
          45deg,
          var(--particle-color-1),
          var(--particle-color-2)
        );
        border-radius: 50%;
        animation: particle-float var(--particle-duration)
          var(--particle-easing) infinite;
      }

      .particle-1 {
        width: var(--particle-size-xl);
        height: var(--particle-size-xl);
        top: 20%;
        left: 10%;
        animation-delay: var(--delay-0);
      }

      .particle-2 {
        width: var(--particle-size-md);
        height: var(--particle-size-md);
        top: 60%;
        left: 80%;
        animation-delay: var(--delay-2);
      }

      .particle-3 {
        width: var(--particle-size-3xl);
        height: var(--particle-size-3xl);
        top: 80%;
        left: 20%;
        animation-delay: var(--delay-4);
      }

      .particle-4 {
        width: var(--particle-size-xs);
        height: var(--particle-size-xs);
        top: 30%;
        left: 70%;
        animation-delay: var(--delay-6);
      }

      .particle-5 {
        width: var(--particle-size-4xl);
        height: var(--particle-size-4xl);
        top: 50%;
        left: 5%;
        animation-delay: var(--delay-8);
      }

      .particle-6 {
        width: var(--particle-size-lg);
        height: var(--particle-size-lg);
        top: 10%;
        left: 60%;
        animation-delay: var(--delay-10);
      }

      .particle-7 {
        width: var(--particle-size-2xl);
        height: var(--particle-size-2xl);
        top: 70%;
        left: 90%;
        animation-delay: var(--delay-3);
      }

      .particle-8 {
        width: var(--particle-size-sm);
        height: var(--particle-size-sm);
        top: 40%;
        left: 40%;
        animation-delay: var(--delay-7);
      }

      .svg-element {
        position: absolute;
        opacity: var(--svg-opacity-min);
        pointer-events: none;
      }

      .svg-float {
        animation: svg-float var(--svg-float-duration) ease-in-out infinite;
      }

      .svg-pulse {
        animation: svg-pulse var(--svg-scale-duration) ease-in-out infinite;
      }

      .svg-element svg {
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
      }

      .svg-element-1 {
        width: var(--svg-size-large);
        height: var(--svg-size-large);
        top: 15%;
        left: 15%;
        animation-delay: var(--delay-0);
      }

      .svg-element-2 {
        width: var(--svg-size-medium);
        height: var(--svg-size-medium);
        top: 25%;
        right: 20%;
        animation-delay: var(--delay-4);
      }

      .svg-element-3 {
        width: var(--svg-size-small);
        height: var(--svg-size-small);
        bottom: 30%;
        left: 25%;
        animation-delay: var(--delay-8);
      }

      .svg-element-4 {
        width: var(--svg-size-medium);
        height: var(--svg-size-medium);
        bottom: 20%;
        right: 15%;
        animation-delay: var(--delay-6);
      }

      .svg-element-5 {
        width: var(--svg-size-large);
        height: var(--svg-size-large);
        top: 60%;
        left: 5%;
        animation-delay: var(--delay-10);
      }

      .svg-primary {
        filter: hue-rotate(0deg) saturate(1.2) brightness(1.1);
      }

      .svg-secondary {
        filter: hue-rotate(60deg) saturate(1.1) brightness(0.9);
      }

      .svg-accent {
        filter: hue-rotate(120deg) saturate(1.3) brightness(1.2);
      }
    </style>

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "OpenCMP Cookies Manager",
        "description": "Solución moderna y completa para la gestión de consentimiento de cookies con integración directa a Google Tag Manager. Compatible con GDPR y CCPA.",
        "applicationCategory": "WebApplication",
        "operatingSystem": "Web",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR"
        },
        "author": {
          "@type": "Organization",
          "name": "OpenCMP"
        },
        "featureList": [
          "Integración directa con Google Tag Manager",
          "Cumplimiento GDPR y CCPA",
          "Tecnología moderna con React y Tailwind CSS",
          "Fácil instalación mediante shadcn CLI",
          "Código fuente completamente personalizable",
          "Diseño responsive y accesible"
        ]
      }
    </script>
  </head>

