---
// Redirect page - automatically redirects to English version
const baseUrl = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Redirect to English version -->
		<meta http-equiv="refresh" content={`0; url=${baseUrl}en/`} />
		<link rel="canonical" href={`${baseUrl}en/`} />
		
		<!-- SEO Meta Tags -->
		<title>OpenCMP Cookies Manager - Redirecting...</title>
		<meta name="description" content="Modern and complete solution for cookie consent management with direct Google Tag Manager integration. GDPR and CCPA compliant." />
		<meta name="robots" content="noindex, nofollow" />
	</head>

	<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen flex items-center justify-center">
		<div class="text-center">
			<div class="mb-6">
				<h1 class="text-4xl font-bold text-slate-800 mb-4">
					<span class="text-blue-600">OpenCMP</span> Cookies Manager
				</h1>
				<p class="text-lg text-slate-600">Redirecting to English version...</p>
			</div>
			
			<div class="text-sm text-slate-500">
				<p>If you are not redirected automatically, <a href={`${baseUrl}en/`} class="text-blue-600 hover:underline">click here</a>.</p>
				<div class="mt-4 space-x-4">
					<a href={`${baseUrl}en/`} class="text-blue-600 hover:underline">English</a>
					<span>•</span>
					<a href={`${baseUrl}es/`} class="text-blue-600 hover:underline">Español</a>
				</div>
			</div>
		</div>
		
		<script define:vars={{ baseUrl }}>
			// Fallback JavaScript redirect
			if (typeof window !== 'undefined') {
				window.location.href = baseUrl + 'en/';
			}
		</script>

	</body>
</html>
